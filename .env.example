# CIPA Fácil — preencha só depois de criar o projeto no Supabase.
# Não use a URL nem a chave do Controle EPI.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Endereço público do app (login, Stripe e e-mails).
# Em desenvolvimento pode ficar vazio: o navegador usa o endereço local.
VITE_PUBLIC_SITE_URL=

# Google AdSense — anúncios no plano gratuito
# VITE_ADSENSE_ENABLED=false

# Aviso de erro por e-mail (opcional)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_MANUTENCAO=
VITE_EMAILJS_PUBLIC_KEY=
VITE_ALERTA_MANUTENCAO_EMAIL=
